<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in – Vaultora</title>
    <style>
      :root {
        --bg: #eef0f3;
        --panel: #f3f3f5;
        --brand-1: #1b1f75;
        --brand-2: #171a64;
        --brand-3: #1e1d73;
        --brand-4: #10164d;
        --primary: #3b4ce7;
        --primary-2: #4f5be7;
        --text: #1e1f29;
        --muted: #5d6476;
        --line: rgba(44, 49, 74, 0.18);
        --white: #ffffff;
        --success: #1ba67a;
        --shadow: 0 28px 60px rgba(31, 37, 83, 0.14);
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100%;
        font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 32px;
      }

      .auth-shell {
        width: min(1360px, 100%);
        min-height: 820px;
        background: var(--panel);
        border-radius: 30px;
        box-shadow: var(--shadow);
        overflow: hidden;
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
      }

      .brand-panel {
        position: relative;
        background: linear-gradient(135deg, #1d1a76 0%, #171a64 18%, #1e1d73 55%, #10164d 100%);
        padding: 52px 52px 36px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        isolation: isolate;
      }

      .brand-panel::before,
      .brand-panel::after {
        content: "";
        position: absolute;
        inset: auto;
        pointer-events: none;
      }

      .brand-panel::before {
        width: 640px;
        height: 640px;
        right: -150px;
        top: -120px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.09);
        box-shadow: 0 0 0 28px rgba(255,255,255,0.015), 0 0 0 56px rgba(255,255,255,0.01);
      }

      .brand-panel::after {
        width: 780px;
        height: 780px;
        left: -240px;
        bottom: -530px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.08);
      }

      .brand-header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 16px;
        color: var(--white);
        font-weight: 700;
        font-size: 2.1rem;
        letter-spacing: -0.05em;
      }

      .logo-mark {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .logo-mark svg {
        width: 100%;
        height: 100%;
        display: block;
      }

      .brand-content {
        position: relative;
        z-index: 1;
        max-width: 630px;
        margin-top: 30px;
      }

      .kicker {
        font-size: 0.9rem;
        letter-spacing: 0.28rem;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.75);
        margin: 0 0 30px;
        font-weight: 600;
      }

      .headline {
        margin: 0;
        color: rgba(255,255,255,0.96);
        font-size: clamp(4rem, 5vw, 7rem);
        line-height: 0.96;
        letter-spacing: -0.08em;
        font-weight: 300;
        font-family: "Georgia", "Times New Roman", serif;
      }

      .headline strong {
        font-weight: 700;
      }

      .subtitle {
        margin-top: 30px;
        max-width: 560px;
        color: rgba(255,255,255,0.8);
        font-size: 1.15rem;
        line-height: 1.6;
        letter-spacing: -0.02em;
      }

      .security-badge {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.1rem;
        color: rgba(255,255,255,0.8);
        margin-top: 22px;
      }

      .security-dot {
        width: 12px;
        height: 12px;
        background: var(--success);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(27, 166, 122, 0.28);
      }

      .form-panel {
        background: #f4f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 54px;
      }

      .form-card {
        width: 100%;
        max-width: 490px;
      }

      .eyebrow {
        display: block;
        font-size: 0.92rem;
        letter-spacing: 0.28rem;
        text-transform: uppercase;
        color: #6b7287;
        margin-bottom: 18px;
        font-weight: 700;
      }

      h1 {
        margin: 0 0 20px;
        font-size: clamp(3rem, 3vw, 4.2rem);
        line-height: 1.02;
        letter-spacing: -0.06em;
        color: #1f2434;
        font-weight: 300;
      }

      .intro {
        margin: 0 0 28px;
        font-size: 1.25rem;
        line-height: 1.5;
        letter-spacing: -0.02em;
        color: #5f6475;
        max-width: 440px;
      }

      .auth-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .field-group {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }

      .field-label {
        font-size: 0.9rem;
        color: #5d6474;
        font-weight: 500;
        margin-left: 2px;
      }

      .form-input {
        width: 100%;
        height: 56px;
        border: 1px solid rgba(99, 105, 123, 0.32);
        border-radius: 12px;
        background: rgba(255,255,255,0.2);
        padding: 0 16px;
        font-size: 1.1rem;
        color: #1a1f2c;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .form-input:focus {
        border-color: rgba(58, 77, 230, 0.75);
        box-shadow: 0 0 0 4px rgba(58, 77, 230, 0.1);
      }

      .primary-btn {
        width: 100%;
        height: 58px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(90deg, var(--primary) 0%, var(--primary-2) 100%);
        color: white;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        cursor: pointer;
        box-shadow: 0 12px 20px rgba(59, 76, 231, 0.28);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        margin-top: 10px;
      }

      .primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 24px rgba(59, 76, 231, 0.34);
      }

      .error-box {
        margin: 8px 0 0;
        color: #b42318;
        background: rgba(180, 35, 24, 0.06);
        border: 1px solid rgba(180, 35, 24, 0.14);
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 0.95rem;
      }

      .small-note {
        margin-top: 18px;
        font-size: 0.8rem;
        line-height: 1.6;
        color: #70788c;
        text-align: center;
      }

      .small-note a {
        color: #3f4fdb;
        text-decoration: none;
        font-weight: 600;
      }

      @media (max-width: 920px) {
        .auth-shell {
          grid-template-columns: 1fr;
        }
        .brand-panel {
          min-height: 440px;
          padding: 32px 28px 22px;
        }
        .form-panel {
          padding: 26px 22px 36px;
        }
        .brand-header {
          font-size: 1.7rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="auth-shell">
      <aside class="brand-panel">
        <div class="brand-header">
          <span class="logo-mark" aria-label="Vaultora logo">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <defs>
                <linearGradient id="shieldGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#7ee7d5" />
                  <stop offset="100%" stop-color="#2fd0a4" />
                </linearGradient>
              </defs>
              <path d="M32 6c9.2 0 18.5 6.3 18.5 18.7V27c0 11.5-8.3 21.3-18.5 30.5C22.3 48.3 14 38.5 14 27v-2.3C14 12.3 22.8 6 32 6Z" fill="rgba(255,255,255,0.12)" />
              <path d="M32 10.3c7.5 0 15 5 15 15.3V27c0 8.8-6.1 16.6-15 24.2-8.9-7.6-15-15.4-15-24.2v-1.4c0-10.3 7.5-15.3 15-15.3Z" fill="#0d4c53"/>
              <path d="M23.2 29.5c2.2-4 5.8-5.9 8.8-5.9 3 0 6.6 1.9 8.8 5.9l-4.5 2.2c-1.3-2.4-3.3-3.9-4.3-3.9-1 0-3 1.5-4.3 3.9l-4.5-2.2Z" fill="url(#shieldGlow)"/>
              <path d="M22.8 33.4c3.9 2.8 7.3 4.2 9.2 4.2 1.9 0 5.3-1.4 9.2-4.2l1.8 4.4c-4.2 3.4-7.9 5.1-11 5.1-3.1 0-6.8-1.7-11-5.1l1.8-4.4Z" fill="url(#shieldGlow)" opacity="0.95"/>
            </svg>
          </span>
          <span>Vaultora</span>
        </div>

        <div class="brand-content">
          <div class="kicker">Documents, with confidence</div>
          <h2 class="headline">
            Your work<br />
            deserves a safer<br />
            place.
          </h2>

          <p class="subtitle">
            Share sensitive files with the right people, keep control of every permission,
            and know what happened at every step.
          </p>

          <div class="security-badge">
            <span class="security-dot"></span>
            <span>Private by design. Accountable by default.</span>
          </div>
        </div>
      </aside>

      <main class="form-panel">
        <div class="form-card">
          <span class="eyebrow">Secure workspace</span>
          <h1>Welcome back</h1>

          <% if (error) { %>
            <div class="error-box"><%= error %></div>
          <% } %>

          <p class="intro">
            Sign in to continue to your documents and shared workspace.
          </p>

          <form method="POST" action="/auth/login" class="auth-form" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= token %>" />

            <div class="field-group">
              <label class="field-label" for="email">Email address</label>
              <input class="form-input" id="email" type="email" name="email" required maxlength="254" />
            </div>

            <div class="field-group">
              <label class="field-label" for="password">Password</label>
              <input class="form-input" id="password" type="password" name="password" required maxlength="128" />
            </div>

            <button class="primary-btn" type="submit">Sign in</button>
          </form>

          <div class="small-note">
            Protected by encrypted storage and an audited access trail.
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
